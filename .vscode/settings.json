{
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.tailwindCSS": "explicit"
  },
  "prettier.configPath": "frontend/.prettierrc.json",
  "prettier.ignorePath": "frontend/.prettierignore",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "restoreTerminals.terminals": [
    {
      "splitTerminals": [
        {
          "name": "Frontend Server",
          "commands": [
            "cd frontend",
            "npm run dev"
          ],
        },
        {
          "name": "Backend Server",
          "commands": [
            "$env:CARGO_TARGET_DIR='target-watch'; cargo watch -w src -x check -x test -x run"
          ]
        }
      ],
    },
    {
      "splitTerminals": [
        {
          "name": "Git",
          "commands": [
            "git status",
          ],
        },
        {
          "name": "Other",
        },
      ],
    }
  ]
}